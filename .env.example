# Copy to `.env.local` for local frontend development (optional — Vite
# picks up `.env.local` automatically, and it's already gitignored).
# Never commit a file containing a real production value.

# Base URL of the backend API (see backend/app/main.py and src/lib/api.js).
# If unset, the frontend falls back to http://localhost:8000 for local dev.
#
# In production (Vercel), set this as a Vercel project environment variable
# to your deployed Render backend's URL, e.g.:
#   VITE_API_BASE_URL=https://lumajewel-backend.onrender.com
#
# This is the ONLY environment variable the frontend needs. It must never
# contain a Gemini/LLM API key — those belong exclusively to the backend's
# own environment (see backend/.env.example). Vite only exposes variables
# prefixed VITE_ to the browser bundle, so nothing prefixed VITE_ is safe
# to treat as a secret.
VITE_API_BASE_URL=http://localhost:8000
