# Copy this file to `.env` in the backend/ directory for local development.
# Never commit the real `.env` file.

# General
APP_ENV=development

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Allowed CORS origins, comma-separated, e.g.
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# One provider or a fallback chain, e.g. groq,gemini,fake
# fake   - rule-based stand-in, no API key needed (default)
# groq   - needs GROQ_API_KEY from https://console.groq.com/keys
# gemini - needs LLM_API_KEY from https://aistudio.google.com/apikey
LLM_PROVIDER=fake

GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

LLM_MODEL=gemini-flash-latest
LLM_API_KEY=

# Chat requests allowed per IP per hour (0 = no limit)
CHAT_RATE_LIMIT_PER_HOUR=20
