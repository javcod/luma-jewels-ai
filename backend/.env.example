# Copy this file to `.env` in the backend/ directory for local development.
# Never commit the real `.env` file.

# General
APP_ENV=development

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Allowed CORS origins, comma-separated, e.g.
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# fake   - rule-based stand-in, no API key needed (default)
# gemini - real model; needs LLM_API_KEY from https://aistudio.google.com/apikey
LLM_PROVIDER=fake
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=
