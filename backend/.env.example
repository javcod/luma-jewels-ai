# Copy this file to `.env` in the backend/ directory for local development.
# Never commit the real `.env` file.

# General
APP_ENV=development

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — the origin(s) the frontend runs on. Comma-separate multiple
# origins to allow local dev and production simultaneously, e.g.:
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# LLM provider — provider-agnostic (see backend/app/llm/base.py).
# Two providers exist:
#
#   fake   - deterministic, rule-based stand-in. No network access or API
#            key required. This is the default, and what the automated
#            test suite always uses regardless of this setting.
#
#   gemini - real Gemini model via the google-genai SDK. Requires
#            LLM_API_KEY to be set to a real Gemini API key (get one at
#            https://aistudio.google.com/apikey). Never commit a real key.
#            LLM_API_KEY must be set ONLY in the backend's own environment
#            (local .env, or the Render dashboard in production) — never
#            in any frontend file, build, or VITE_* variable.
#
LLM_PROVIDER=fake
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Future configuration (documented as placeholders only — NOT implemented):
#
# Database connection (not yet planned as required)
# DATABASE_URL=
# ---------------------------------------------------------------------------
