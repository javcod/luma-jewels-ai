# Production env for Vite builds (auto-loaded by `vite build`, which Vercel
# runs via `npm run build` — see vercel.json). Committed intentionally:
# VITE_* values are always inlined into the public client bundle, so this
# is not a secret — it's just the deployed backend's public URL. See
# .env.example for the full explanation and local-dev equivalent.
#
# This fixes the production frontend calling the http://localhost:8000
# fallback (baked in when VITE_API_BASE_URL isn't set at build time)
# instead of the real Render backend.
VITE_API_BASE_URL=https://lumajewel-backend.onrender.com
